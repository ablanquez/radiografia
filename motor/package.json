{
  "name": "@radiografia/motor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "El motor de RadiografIA: aplica paquetes de reglas en JSON a un texto en español y devuelve, por paquete, las señales y su puntuación. Sin interfaz. Genera también el validador standalone que llevará el navegador.",
  "scripts": {
    "test": "node --test \"src/**/*.spec.ts\" \"herramientas/**/*.spec.ts\"",
    "tipos": "tsc --noEmit",
    "generar": "node src/generar-validador.ts"
  },
  "exports": {
    "./navegador": {
      "types": "./src/navegador.ts",
      "default": "./src/navegador.ts"
    },
    "./validacion": {
      "types": "./src/validacion.ts",
      "default": "./src/validacion.ts"
    },
    "./validador": {
      "types": "./src/validador-standalone.d.ts",
      "default": "./dist/validador.standalone.js"
    }
  },
  "imports": {
    "#validador-standalone": {
      "types": "./src/validador-standalone.d.ts",
      "default": "./dist/validador.standalone.js"
    }
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
