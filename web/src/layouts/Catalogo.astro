---
/**
 * El armazón de las páginas del catálogo (encargo 7.1, b): html, head,
 * cabecera con el nombre de la web y el contenido de cada página en el
 * <slot />. Funciona, no luce: el diseño es del punto 10. La página del
 * analizador (index.astro) no lo usa: no se toca más que para su enlace.
 * Desde el 10.4 (Tanda 1), los colores y las familias tipográficas salen de
 * los tokens de diseño (estilos/tokens.css): ningún color suelto. La letra,
 * la escala, el foco, los botones y los campos, de estilos/base.css; los
 * párrafos largos de las fichas, en Literata (DISEÑO §5).
 *
 * [DOC] https://docs.astro.build/en/basics/layouts/ — «Layouts are Astro
 *    components used to provide a reusable UI structure, such as a page
 *    template»; llevan «a page shell (<html>, <head> and <body> tags)» y «a
 *    <slot /> to specify where individual page content should be injected»;
 *    «commonly placed in a src/layouts directory».
 * [DOC] https://docs.astro.build/en/reference/directives-reference/#settext —
 *    una expresión {texto} se escapa: set:text «is automatically escaped by
 *    Astro» y equivale a «directly inserting a variable in template
 *    expressions». Ningún set:html en el catálogo: lo que viene de los
 *    paquetes entra como texto (OWASP, encargo 6.2).
 * [PROPIO] `<link rel="icon" href="data:,">`, como en index.astro: sin él,
 *    Chrome pide /favicon.ico por su cuenta.
 */
import { urlDelAnalizador } from '../catalogo/catalogo.ts';
import Recursos from '../componentes/Recursos.astro';
import '../estilos/tokens.css';
import '../estilos/fuentes.css';
import '../estilos/base.css';

interface Props {
  /** Lo que va delante de «RadiografIA» en el título de la pestaña. */
  titulo: string;
}

const { titulo } = Astro.props;
const analizador = urlDelAnalizador(import.meta.env.BASE_URL);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="data:," />
    <Recursos />
    <title>{titulo} · RadiografIA</title>
  </head>
  <body>
    <header>
      <p class="marca"><a href={analizador}>RadiografIA</a></p>
    </header>
    <main>
      <slot />
    </main>
    <style is:global>
      body {
        max-width: 52rem;
        margin: 0 auto;
        padding: 1rem;
      }
      .marca {
        font-weight: 600;
      }
      .id-regla,
      .datos {
        font-size: var(--tipografia-tamano-secundario);
        line-height: var(--tipografia-interlineado-secundario);
        color: var(--color-ink-2);
      }
      .id-regla {
        margin-top: 0;
      }
      .en-claro {
        font-weight: 600;
      }
      /* En la ficha, la frase en claro bajo el nombre es texto largo, como en el modelo. */
      h1 + .en-claro {
        font-family: var(--tipografia-font-family-texto);
        font-size: var(--tipografia-tamano-cuerpo);
        line-height: var(--tipografia-interlineado-cuerpo);
        font-weight: 400;
      }
      .presentacion {
        color: var(--color-ink-2);
      }
      dt {
        font-weight: 700;
      }
      dd {
        margin: 0 0 0.5rem 0;
      }
      code {
        overflow-wrap: anywhere;
      }
      .reglas {
        list-style: none;
        padding-left: 0;
      }
      .reglas h2 {
        margin-bottom: 0;
      }
      .datos {
        margin: 0;
      }
      fieldset label {
        display: inline-block;
        margin-right: 1rem;
      }
      .ejemplo {
        white-space: pre-wrap;
        font-family: var(--tipografia-font-family-texto);
        font-size: var(--tipografia-tamano-cuerpo);
        line-height: var(--tipografia-interlineado-cuerpo);
        border-left: 3px solid var(--color-line);
        padding-left: 0.75rem;
      }
    </style>
  </body>
</html>
