---
/**
 * El índice del catálogo de reglas, /reglas/ (encargo 7.1, b; plan, punto 7):
 * todas las reglas de los dos paquetes, generadas en build, con un buscador y
 * tres filtros (familia, severidad, detector). Funciona, no luce: el diseño es
 * del punto 10.
 *
 * Por regla: su nombre, que enlaza a su ficha, y debajo su frase en claro
 * (encargo 9.2, b; firmada por Antonio en la parada 1); id y paquete; familia,
 * detector, severidad, nivel de evidencia y peso; y la primera frase de su
 * explicación. Cada fila lleva en data-* lo que miran el buscador (nombre, id
 * y explicación entera, ya pasados por paraBuscar) y los filtros.
 *
 * El buscador y los filtros son JavaScript del navegador sobre esta lista ya
 * pintada (catalogo/buscador.ts): ocultan y enseñan filas, sin librerías y
 * sin volver a pintar. Sin JavaScript, la lista se ve entera.
 * El orden de las filas y de las casillas de familia y de detector, el de
 * orden.ts (cierre del 7.1); las de severidad, baja → media → alta.
 * Cada control con su etiqueta: el buscador con <label for>, y cada casilla
 * dentro de su <label>, agrupadas en un <fieldset> con su <legend>.
 * [DOC] https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/label
 *    — el control se asocia a la etiqueta con «for» o poniéndolo dentro.
 * [DOC] https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/fieldset
 *    — «used to group several controls as well as labels»; <legend> le da
 *    título.
 * El recuento («50 reglas») va en una región viva, ya en el HTML inicial,
 * para que el lector de pantalla anuncie cada cambio del filtro.
 * [DOC] https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA/Guides/Live_regions
 *    — «Normally, only aria-live="polite" is used»; «The most reliable way to
 *    ensure that live regions are registered is to include them in the
 *    initial markup»; y con role="status», «To maximize compatibility, add a
 *    redundant aria-live="polite"».
 */
import Catalogo from '../../layouts/Catalogo.astro';
import { DETECTORES, primeraFrase, SEVERIDADES, urlDeRegla } from '../../catalogo/catalogo.ts';
import { paraBuscar } from '../../catalogo/filtro.ts';
import { enOrden } from '../../orden.ts';
import { ENTRADAS, PAQUETES } from '../../catalogo/paquetes.ts';
import { nombreDeRegla } from '../../pantalla/humanizar.ts';
import * as textos from '../../textos.ts';

const base = import.meta.env.BASE_URL;
const peso = new Intl.NumberFormat('es');
// El orden (cierre del 7.1, orden.ts): paquetes como los carga el analizador; familias y reglas, alfabéticas por su nombre.
const posicion = new Map(PAQUETES.map((p, i) => [p.cabecera.nombre, i]));
const familias = enOrden(
  PAQUETES.flatMap((p, i) => p.cabecera.familias.map((f) => ({ i, nombre: f.nombre, valor: `${p.cabecera.nombre}::${f.id}`, etiqueta: `${f.nombre} (${p.cabecera.nombre})` }))),
  (f) => [f.i, f.nombre],
);
const detectores = enOrden(DETECTORES, (d) => [d]);
const filas = enOrden(
  ENTRADAS.map(({ regla, paquete, familia }) => {
    const nombre = nombreDeRegla(regla.id, regla);
    return { regla, paquete, familia, nombre, texto: paraBuscar(`${nombre} ${regla.id} ${regla.explicacion}`) };
  }),
  (x) => [posicion.get(x.paquete.nombre) ?? 0, x.familia.nombre, x.nombre],
);
---

<Catalogo titulo={textos.CATALOGO}>
  <h1>{textos.CATALOGO}</h1>
  <p class="presentacion texto-largo">{textos.PRESENTACION_DEL_CATALOGO}</p>
  <form id="filtros" role="search">
    <label for="buscar">{textos.BUSCAR}</label>
    <input id="buscar" type="search" />
    <fieldset>
      <legend>{textos.FAMILIA}</legend>
      {familias.map((f) => <label><input type="checkbox" name="familia" value={f.valor} /> {f.etiqueta}</label>)}
    </fieldset>
    <fieldset>
      <legend>{textos.SEVERIDAD}</legend>
      {SEVERIDADES.map((s) => <label><input type="checkbox" name="severidad" value={s} /> {s}</label>)}
    </fieldset>
    <fieldset>
      <legend>{textos.DETECTOR}</legend>
      {detectores.map((d) => <label><input type="checkbox" name="detector" value={d} /> {d}</label>)}
    </fieldset>
    <button id="quitar-filtros" type="button">{textos.QUITAR_FILTROS}</button>
  </form>
  <p id="recuento" role="status" aria-live="polite">{textos.recuentoDeReglas(filas.length)}</p>
  <ul id="reglas" class="reglas">
    {
      filas.map(({ regla, paquete, familia, nombre, texto }) => (
        <li data-texto={texto} data-familia={`${paquete.nombre}::${familia.id}`} data-severidad={regla.severidad} data-detector={regla.detector}>
          <h2><a href={urlDeRegla(base, regla.id)}>{nombre}</a></h2>
          {regla.enClaro !== undefined && <p class="en-claro">{regla.enClaro}</p>}
          <p class="id-regla">{regla.id} · {paquete.nombre}</p>
          <p class="datos">
            {textos.FAMILIA}: {familia.nombre} · {textos.DETECTOR}: {regla.detector} · {textos.SEVERIDAD}: {regla.severidad} ·{' '}
            {textos.NIVEL_DE_EVIDENCIA}: {regla.nivelEvidencia} · {textos.PESO}: {peso.format(regla.peso)}
          </p>
          <p>{primeraFrase(regla.explicacion)}</p>
        </li>
      ))
    }
  </ul>
  <script>
    import '../../catalogo/buscador.ts';
  </script>
</Catalogo>
